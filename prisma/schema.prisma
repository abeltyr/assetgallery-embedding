// =============================================================================
// MODELS
// =============================================================================

/// Core section record — slim, references only what's unique to the section.
/// appCode, platformCode, versionCode, pageCode, sectionCode live elsewhere.
model Section {
  id        String @id @default(uuid())
  sectionId String @unique @map("section_id")
  fileKey   String @map("file_key")

  // Original raw JSON blob preserved for auditing
  rawJson Json @map("raw_json")

  // Top-level text fields from the classification
  description         String? @map("description") @db.Text
  classificationNotes String? @map("classification_notes") @db.Text

  // Processing metadata
  modelUsed    String   @map("model_used")
  status       String   @default("success")
  errorMessage String?  @map("error_message") @db.Text
  processedAt  DateTime @map("processed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  // --- Relations to sub-tables ---
  context         SectionContext?         @relation
  aesthetic       SectionAesthetic?       @relation
  composition     SectionComposition?     @relation
  uiElements      SectionUiElements?      @relation
  contentStrategy SectionContentStrategy? @relation
  designTokens    SectionDesignTokens?    @relation
  embedding       SectionEmbedding?       @relation

  @@map("sections")
}

/// Context classification for a section
model SectionContext {
  id        String  @id @default(uuid())
  sectionId String  @unique @map("section_id")
  section   Section @relation(fields: [sectionId], references: [sectionId], onDelete: Cascade)

  industryVerticals IndustryVertical[] @map("industry_verticals")
  pageType          PageType?          @map("page_type")
  sectionType       SectionType?       @map("section_type")
  viewport          Viewport?          @map("viewport")

  @@map("section_contexts")
}

/// Aesthetic classification for a section
model SectionAesthetic {
  id        String  @id @default(uuid())
  sectionId String  @unique @map("section_id")
  section   Section @relation(fields: [sectionId], references: [sectionId], onDelete: Cascade)

  overallVibes         OverallVibe[]         @map("overall_vibes")
  themeMode            ThemeMode?            @map("theme_mode")
  colorPaletteStyles   ColorPalette[]        @map("color_palette_styles")
  backgroundTreatments BackgroundTreatment[] @map("background_treatments")

  @@map("section_aesthetics")
}

/// Composition classification for a section
model SectionComposition {
  id        String  @id @default(uuid())
  sectionId String  @unique @map("section_id")
  section   Section @relation(fields: [sectionId], references: [sectionId], onDelete: Cascade)

  layoutStructures LayoutStructure[] @map("layout_structures")
  sectionDividers  SectionDivider?   @map("section_dividers")

  @@map("section_compositions")
}

/// UI elements classification for a section
model SectionUiElements {
  id        String  @id @default(uuid())
  sectionId String  @unique @map("section_id")
  section   Section @relation(fields: [sectionId], references: [sectionId], onDelete: Cascade)

  typographyStyles    TypographyStyle[]    @map("typography_styles")
  textDecorations     TextDecoration[]     @map("text_decorations")
  iconStyles          IconStyle[]          @map("icon_styles")
  illustrationStyles  IllustrationStyle[]  @map("illustration_styles")
  productImageryTypes ProductImagery[]     @map("product_imagery_types")
  navigationStyles    NavigationStyle[]    @map("navigation_styles")
  containerStyles     ContainerStyle[]     @map("container_styles")
  buttonStyles        ButtonStyle[]        @map("button_styles")
  animationIndicators AnimationIndicator[] @map("animation_indicators")

  @@map("section_ui_elements")
}

/// Content strategy classification for a section
model SectionContentStrategy {
  id        String  @id @default(uuid())
  sectionId String  @unique @map("section_id")
  section   Section @relation(fields: [sectionId], references: [sectionId], onDelete: Cascade)

  tonesOfVoice      ToneOfVoice[]      @map("tones_of_voice")
  visualToTextRatio VisualToTextRatio? @map("visual_to_text_ratio")
  contentFormats    ContentFormat[]    @map("content_formats")

  @@map("section_content_strategies")
}

/// Design token specs for a section
model SectionDesignTokens {
  id        String  @id @default(uuid())
  sectionId String  @unique @map("section_id")
  section   Section @relation(fields: [sectionId], references: [sectionId], onDelete: Cascade)

  borderRadius           BorderRadius?           @map("border_radius")
  spacingDensity         SpacingDensity?         @map("spacing_density")
  glassmorphismIntensity GlassmorphismIntensity? @map("glassmorphism_intensity")
  shadowElevation        ShadowElevation?        @map("shadow_elevation")
  contrastLevel          ContrastLevel?          @map("contrast_level")

  @@map("section_design_tokens")
}

/// Embedding stored separately — linked to section via sectionId
model SectionEmbedding {
  id        String  @id @default(uuid())
  sectionId String  @unique @map("section_id")
  section   Section @relation(fields: [sectionId], references: [sectionId], onDelete: Cascade)

  combinedText String                       @map("combined_text") @db.Text
  embedding    Unsupported("vector(1536)")? @map("embedding")

  provider   String   @map("provider")
  model      String   @map("model")
  embeddedAt DateTime @default(now()) @map("embedded_at")

  @@map("section_embeddings")
}
